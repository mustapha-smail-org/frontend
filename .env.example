# Base URL of the API Gateway that fronts the Catalog Service.
# Leave as the relative default in development so the Vite proxy handles CORS.
VITE_API_BASE_URL=/

# Optional: override the dev proxy target. Defaults to http://localhost:8080,
# the API Gateway's dev port. Point it at http://localhost:8081 to bypass the
# gateway and talk to the Catalog Service directly.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Map tiles. The public OSM endpoint is NOT a production CDN (PRD FR-MAP-006);
# replace these with a provider you are entitled to use before deploying.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional dark-theme tile set. When omitted, dark mode reuses VITE_MAP_TILE_URL
# with a CSS inversion filter, which is legible but not as good as real dark tiles.
# VITE_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Which service the "Open in Maps" links point at.
# One of: google (default) | apple | openstreetmap | bing
VITE_MAP_LINK_PROVIDER=google
